# Local skill runs (business references, packshots, drafts)
workspace/*
!workspace/.gitkeep
# templates/ and runs/ live under workspace/ and stay local

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.code-workspace

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets
.env
.env.*
*.pem

# Large / binary dumps often dropped by mistake
*.pptx
*.ppt
*.pdf
!skills/**/examples/**

# Engine deps / local build outputs
**/node_modules/
skills/**/engines/**/*.pptx
skills/**/engines/**/samples/out-*.pptx

# OOXML gold binaries (local; too large / license-sensitive for public git)
skills/pharma-courseware-replication/engines/**/gold/*.pptx
skills/pharma-courseware-replication/engines/**/vendor/
workspace/runs/
